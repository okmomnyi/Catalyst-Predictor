# Copy this file to .env and fill in your real values.
# NEVER commit .env — it is listed in .gitignore.

# ── NVIDIA NIM (build.nvidia.com) ─────────────────────────────────────────────
# Free access to open-source models. Get your key at https://build.nvidia.com
NVIDIA_API_KEY=nvapi-your_primary_nvidia_key_here

# Optional fallback key — used automatically when primary hits rate limit / timeout
NVIDIA_API_KEY_2=nvapi-your_secondary_nvidia_key_here

# Model to use — any model ID from build.nvidia.com (this is not tied to one model).
# Reasoning models like deepseek-ai/deepseek-r1 are supported; their <think> blocks
# are stripped automatically before JSON parsing.
MODEL_ID=deepseek-ai/deepseek-r1

# ── Supabase (optional) ───────────────────────────────────────────────────────
# Leave blank to use local JSON fallback storage instead
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
